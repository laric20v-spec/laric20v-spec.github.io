<style>
:root{--bg:#fff;--ink:#0a0a0a;--soft:#f3f3f1;--mute:#6b6b6b;--dark:#000;--on-dark:#fff;--lime:#d8f56b;--r:28px;color-scheme:light;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-behavior:smooth;scroll-padding-top:90px}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,sans-serif;line-height:1.5;overflow-x:hidden}
a{color:inherit;text-decoration:none}
:focus-visible{outline:2px solid var(--lime);outline-offset:3px}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
header{position:fixed;top:env(safe-area-inset-top,0px);left:0;right:0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:18px 32px;mix-blend-mode:difference;color:#fff;font-size:13px;font-weight:500}
header nav{display:flex;gap:28px}
header a{position:relative}
header nav a::after{content:"";position:absolute;left:0;bottom:-3px;height:1px;width:100%;background:currentColor;transform:scaleX(0);transform-origin:right;transition:transform .45s cubic-bezier(.2,.8,.2,1)}
header nav a:hover::after{transform:scaleX(1);transform-origin:left}
.btn{display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--ink);background:var(--ink);color:#fff;border-radius:999px;padding:10px 22px;font:500 13px Inter,sans-serif;cursor:pointer;transition:transform .3s cubic-bezier(.2,.8,.2,1),background .3s,color .3s}
.btn:hover{transform:translateY(-2px)}
.btn.ghost{background:transparent;color:var(--ink)}
.btn.light{background:#fff;color:#000;border-color:#fff}
.btn.lime{background:var(--lime);border-color:var(--lime);color:#000}
/* hero */
.hero{position:relative;min-height:100vh;display:grid;grid-template-columns:1fr 1.05fr;gap:40px;align-items:center;padding:110px max(24px,calc((100vw - 1120px)/2)) 60px;overflow:hidden}
.star{position:absolute;left:-90px;top:-90px;width:300px;height:300px;background:#e9e9e6;clip-path:polygon(50% 0,62% 38%,100% 50%,62% 62%,50% 100%,38% 62%,0 50%,38% 38%);animation:spin 40s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
h1{font-size:clamp(34px,4.7vw,62px);line-height:1.02;letter-spacing:-.035em;margin:0 0 18px;font-weight:600}
h1 .l{display:block;white-space:nowrap;clip-path:inset(-.12em -100vw -.25em -.12em)}
h1 .l span{display:block;transform:translateY(140%);animation:up 1s cubic-bezier(.2,.8,.2,1) forwards}
h1 .l:nth-child(2) span{animation-delay:.1s}h1 .l:nth-child(3) span{animation-delay:.2s}h1 .l:nth-child(4) span{animation-delay:.3s}
@keyframes up{to{transform:none}}
.hero p.sub{color:var(--mute);margin:0 0 26px}
.row{display:flex;gap:10px;flex-wrap:wrap}
.frame{position:relative;border-radius:14px;background:#fff;box-shadow:0 30px 60px -25px rgba(0,0,0,.35);overflow:hidden;aspect-ratio:4/3;transition:transform .25s ease-out;will-change:transform}
.art{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.art.ph{background:var(--g)}
/* about */
.about{background:var(--dark);color:var(--on-dark);margin:0 12px;border-radius:var(--r);padding:90px 0;overflow:hidden}
.about .wrap{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center}
.bar{width:90px;height:9px;border-radius:9px;background:#fff;margin-bottom:34px}
.about h2{font-size:clamp(24px,3.2vw,38px);line-height:1.2;font-weight:500;letter-spacing:-.02em;margin:0 0 30px}
.glass{background:#161616;border:1px solid #2a2a2a;border-radius:20px;padding:26px;color:#cfcfcf;font-size:15px;margin-bottom:26px}
.char{position:relative;aspect-ratio:1;border-radius:24px;overflow:hidden;background:var(--lime);transition:transform .25s ease-out}
/* marquee */
.marq{overflow:hidden;white-space:nowrap;margin:60px 0 0;font-size:14px}
.marq div{display:inline-block;animation:mq 30s linear infinite}
@keyframes mq{to{transform:translateX(-50%)}}
section{padding:70px 0}
h3.t{font-size:28px;letter-spacing:-.02em;margin:0 0 30px;font-weight:600}
/* portfolio */
.grid{display:grid;grid-template-columns:1fr 1fr;gap:28px 24px}
.card{cursor:pointer;background:none;border:0;padding:0;text-align:left;font:inherit;color:inherit;perspective:900px;opacity:0;transform:translateY(40px);transition:opacity .9s,transform .9s cubic-bezier(.2,.8,.2,1)}
.card.in{opacity:1;transform:none}
.card .img{position:relative;aspect-ratio:1.15;border-radius:14px;overflow:hidden;transition:transform .2s ease-out,box-shadow .4s;transform-style:preserve-3d}
.card:hover .img{box-shadow:0 30px 50px -25px rgba(0,0,0,.6)}
.card .img .art{transition:transform .8s cubic-bezier(.2,.8,.2,1)}
.card:hover .art{transform:scale(1.08)}
.glare{position:absolute;inset:0;background:radial-gradient(circle at var(--x,50%) var(--y,50%),rgba(255,255,255,.28),transparent 55%);opacity:0;transition:opacity .3s}
.card:hover .glare{opacity:1}
.meta{display:flex;justify-content:space-between;font-size:13px;font-weight:600;margin-top:12px}
.meta span:last-child{font-weight:400;color:var(--mute)}


.info{display:grid;grid-template-columns:1.2fr 1fr;gap:40px;border-top:1px solid #e5e5e2;margin-top:70px;padding-top:34px;font-size:13px}
.info b{display:block;margin-bottom:8px}.info p{color:var(--mute);margin:0;max-width:44ch}
.info a{display:block;color:var(--mute);transition:color .2s,transform .3s}.info a:hover{color:var(--ink);transform:translateX(5px)}
/* services */
.serv{background:var(--dark);color:var(--on-dark);margin:0 12px;border-radius:var(--r);padding:80px 0}
.srow{display:grid;grid-template-columns:1.1fr 1fr;gap:50px;align-items:center;background:#161616;border-radius:22px;padding:34px;margin-bottom:26px;transition:background .4s}
.srow:hover{background:#1d1d1d}
.simg{position:relative;aspect-ratio:1.25;border-radius:12px;overflow:hidden;background:#222}
.srow:hover .simg .art{transform:scale(1.06) rotate(-.6deg)}
.simg .art{transition:transform 1s cubic-bezier(.2,.8,.2,1)}
.tag{position:absolute;left:12px;top:12px;z-index:2;background:#0009;border:1px solid #fff3;border-radius:7px;font-size:10px;padding:3px 9px}
.srow h4{font-size:19px;font-weight:500;margin:0 0 10px}
.srow p{color:#b5b5b5;font-size:13px;max-width:44ch;margin:0 0 20px}
/* contact */
.contact{background:var(--dark);color:var(--on-dark);margin:0 12px;padding:80px 0}
.contact .wrap{display:grid;grid-template-columns:1fr 1.2fr;gap:50px}
.contact h2{font-size:clamp(28px,4vw,40px);letter-spacing:-.02em;margin:0 0 20px;font-weight:600}
.soc{display:flex;gap:14px}.soc a{width:30px;height:30px;display:grid;place-items:center;border:1px solid #fff5;border-radius:50%;font-size:12px;transition:background .3s,color .3s,transform .3s}.soc a:hover{background:var(--lime);color:#000;transform:rotate(-12deg) scale(1.1)}
label{display:block;font-size:12px;margin:14px 0 6px}
input,textarea{width:100%;background:#1d1d1d;border:1px solid transparent;border-radius:6px;padding:11px 12px;color:#fff;font:14px Inter,sans-serif;transition:border-color .3s,background .3s}
input:focus,textarea:focus{outline:none;border-color:var(--lime);background:#222}
textarea{min-height:130px;resize:vertical}
.form .row .btn{margin-top:0}
#msg{margin:12px 0 0;font-size:13px;color:var(--lime);min-height:20px}
/* modal */
.modal{position:fixed;inset:0;z-index:50;background:#000d;display:grid;place-items:center;padding:24px;opacity:0;pointer-events:none;transition:opacity .4s;backdrop-filter:blur(8px)}
.modal.open{opacity:1;pointer-events:auto}
.mbox{width:min(900px,100%);background:#0f0f0f;color:#fff;border-radius:22px;overflow:hidden;transform:translateY(40px) scale(.94);transition:transform .6s cubic-bezier(.2,.8,.2,1);max-height:92vh;overflow-y:auto}
.modal.open .mbox{transform:none}
.mbox .big{position:relative;aspect-ratio:16/10}
.mbox .txt{padding:26px 30px 30px;display:flex;justify-content:space-between;gap:20px;align-items:center;flex-wrap:wrap}
.mbox h5{font-size:22px;margin:0 0 4px}.mbox p{margin:0;color:#aaa;font-size:14px}

.char{background:none}.char .art.ph{background:none}.char img.art{object-fit:contain}
.frame img.art{object-position:28% center}
.faq{padding:90px 0}.faq .wrap{max-width:820px}
#fq{background:var(--soft);color:var(--ink);border-radius:999px;padding:13px 20px;margin-bottom:22px}
#fq:focus{border-color:var(--ink);background:#fff}
.fi{border-top:1px solid #e5e5e2}.fi:last-of-type{border-bottom:1px solid #e5e5e2}
.fq{display:flex;justify-content:space-between;align-items:center;gap:20px;width:100%;background:none;border:0;padding:20px 4px;font:600 17px Inter,sans-serif;color:var(--ink);text-align:left;cursor:pointer}
.fq i{flex:none;width:28px;height:28px;border-radius:50%;border:1px solid var(--ink);position:relative;transition:transform .5s cubic-bezier(.2,.8,.2,1),background .3s,border-color .3s}
.fq i::before,.fq i::after{content:"";position:absolute;left:50%;top:50%;width:11px;height:1.5px;background:currentColor;transform:translate(-50%,-50%)}
.fq i::after{transform:translate(-50%,-50%) rotate(90deg);transition:transform .5s cubic-bezier(.2,.8,.2,1)}
.fi.open .fq i{transform:rotate(180deg);background:var(--lime);border-color:var(--lime)}
.fi.open .fq i::after{transform:translate(-50%,-50%) rotate(0)}
.fa{display:grid;grid-template-rows:0fr;transition:grid-template-rows .5s cubic-bezier(.2,.8,.2,1)}
.fa>div{overflow:hidden}.fa p{margin:0;padding:0 4px 22px;color:var(--mute);max-width:60ch}
.fi.open .fa{grid-template-rows:1fr}
#fe{color:var(--mute)}.faqcta{margin-top:30px;display:flex;gap:14px;align-items:center;flex-wrap:wrap;font-size:14px;color:var(--mute)}
.foot{background:var(--dark);color:#fff;margin:0 12px;padding-bottom:env(safe-area-inset-bottom,0px)}
.fwrap{max-width:1120px;margin:0 auto;border-top:1px solid #2a2a2a;padding:28px 24px;display:flex;justify-content:space-between;align-items:center;gap:18px 30px;flex-wrap:wrap;font-size:13px}
.flogo{font-weight:700;font-size:18px;letter-spacing:-.02em}
.fl2{display:flex;gap:22px;flex-wrap:wrap}.fl2 a{color:#bbb;transition:color .2s}.fl2 a:hover{color:var(--lime)}
.fwrap small{color:#888;font-size:12px}
.wa{position:fixed;right:18px;bottom:calc(18px + env(safe-area-inset-bottom,0px));z-index:30;background:var(--lime);color:#000;border-radius:999px;padding:12px 20px;font:600 13px Inter,sans-serif;box-shadow:0 10px 30px -10px rgba(0,0,0,.5);transition:transform .35s cubic-bezier(.2,.8,.2,1)}
.wa:hover{transform:translateY(-3px) scale(1.04)}
.contact{border-radius:var(--r) var(--r) 0 0}.contact .row{margin-top:18px}
.mbox .big{background:#000}.mbox .big img.art{object-fit:contain}#mimg{transition:opacity .2s}#mimg.fade{opacity:0}
.thumbs{display:flex;gap:10px;padding:14px 30px 0;overflow-x:auto}
.thumbs button{flex:none;width:84px;aspect-ratio:4/3;border-radius:8px;overflow:hidden;border:2px solid transparent;padding:0;background:#000;cursor:pointer;opacity:.5;transition:opacity .3s,border-color .3s,transform .3s}
.thumbs button:hover{opacity:1;transform:translateY(-2px)}.thumbs button.on{opacity:1;border-color:var(--lime)}
.thumbs img{width:100%;height:100%;object-fit:cover;display:block}
.avatar{position:fixed;z-index:21;top:calc(env(safe-area-inset-top,0px) + 8px);left:112px;width:40px;height:40px;display:block}
.avatar img{width:100%;height:100%;display:block;filter:drop-shadow(0 0 1.5px rgba(255,255,255,.9));transition:transform .45s cubic-bezier(.2,.8,.2,1)}
.avatar:hover img{transform:rotate(-8deg) scale(1.15)}
header>a:first-child{display:inline-block;width:74px;white-space:nowrap}
@media(max-width:820px){.avatar{left:94px}}
@media(max-width:560px){.avatar{width:36px;height:36px;top:calc(env(safe-area-inset-top,0px) + 7px)}header{font-size:12px}header nav{gap:10px}}
.thumbs{position:relative}
.nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:46px;height:46px;border-radius:50%;border:0;background:rgba(255,255,255,.92);color:#000;font:600 28px/1 Inter,sans-serif;padding:0 0 4px;cursor:pointer;display:grid;place-items:center;transition:transform .3s cubic-bezier(.2,.8,.2,1),background .3s}
.nav[hidden]{display:none}.nav:hover{background:var(--lime);transform:translateY(-50%) scale(1.1)}
.nav.prev{left:14px}.nav.next{right:14px}
@media(max-width:560px){.nav{width:38px;height:38px;font-size:22px}.nav.prev{left:8px}.nav.next{right:8px}}
@media(max-width:560px){header nav a:first-child,header>a:last-child{display:none}}
@media(max-width:820px){
.hero,.about .wrap,.contact .wrap,.srow,.info{grid-template-columns:1fr}
.hero{padding-top:100px}.grid{grid-template-columns:1fr}
header nav{gap:14px}header{padding:16px 18px}
.card{cursor:pointer}}
@media(hover:none){.card{cursor:pointer}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}h1 .l span{transform:none}.card{opacity:1;transform:none}html{scroll-behavior:auto}}
</style>
</head>
